# ==============================================================================
# JurisAI Environment Configuration
# ==============================================================================

# Backend Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated, or leave empty/asterisk to allow all origins e.g. Vercel)
# Example: CORS_ORIGINS=https://jurisai-client.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# Persistent SQLite Auth & Case History Database Path (defaults to ./data/jurisai_auth.db)
# AUTH_DB_PATH=/var/data/jurisai_auth.db

# Persistent ChromaDB Vector Store Directory (mapped to host ./chroma_db)
CHROMA_PERSIST_DIR=./chroma_db

# Frontend API Target (for Vercel deployment: point to your Render backend URL)
# Example: VITE_API_URL=https://jurisai-backend.onrender.com
VITE_API_URL=

# Local Ollama / LLM Endpoint
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Port Mappings on Host
FRONTEND_PORT=5173
BACKEND_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
OLLAMA_PORT=11434
